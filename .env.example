# ===== 应用 =====
PROJECT_NAME=Agent Backend
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=15401

# ===== PostgreSQL =====
DB_HOST=127.0.0.1
DB_PORT=15400
DB_USER=root
DB_PASSWORD=root
DB_NAME=agent_backend

# ===== Redis =====
# 宿主机端口为 16380（容器内仍是 6379），本地直连请用 16380
REDIS_HOST=localhost
REDIS_PORT=16380
REDIS_DB=0
REDIS_PASSWORD=

# ===== 跨域 =====
CORS_ORIGINS=http://localhost:15173,http://127.0.0.1:15173

# ===== Day 15 可观测性（可选，不配就不上报；配完需重启后端）=====
# 这两个 SDK 自己直接读环境变量，所以不走 Settings（见 day15_observability.py 的说明）。
# LangSmith：注册 smith.langchain.com 后取消注释并填 key
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_你的key
# LANGSMITH_PROJECT=agent-course-day15
# Langfuse：pip install langfuse 之后取消注释（开源可自部署，数据不出内网）
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
